<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ 자동 백업 · 기기 간 이전에서 로컬 DB · 설정 · 키 파일을 뺀다(설계 4-0).
   기기 키는 Keystore 에 있어 백업되지 않는다. DB 만 복원되면 "데이터는 있는데 열쇠가 없는" 상태가 되므로,
   복원은 앱 자체 암호화 백업으로만 한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kkotsin.db" />
        <exclude domain="database" path="kkotsin.db-wal" />
        <exclude domain="database" path="kkotsin.db-shm" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="crypto/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="kkotsin.db" />
        <exclude domain="database" path="kkotsin.db-wal" />
        <exclude domain="database" path="kkotsin.db-shm" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="crypto/" />
    </device-transfer>
</data-extraction-rules>
