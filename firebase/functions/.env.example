# 이 예제를 .env.<Firebase 프로젝트 ID>로 복사하고 직접 설정한다. 실제 파일은 Git에서 제외된다.
KAKAO_APP_ID=0
KAKAO_ADMIN_KEY=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.sadturtleman.kkotsin
APPLE_PRIVATE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
# SMTP_PASSWORD는 여기에 넣지 않고 Secret Manager에 등록한다.
BACKUP_RETENTION_ENABLED=false
